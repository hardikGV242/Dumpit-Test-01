        <name>Contact_Location</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!Get_Contact_Details.MailingCity}) || ISBLANK({!Get_Contact_Details.MailingCity}), 
IF(ISNULL({!Get_Contact_Details.MailingState}) || ISBLANK({!Get_Contact_Details.MailingState}),
IF(ISNULL({!Get_Contact_Details.MailingCountry}) || ISBLANK({!Get_Contact_Details.MailingCountry}),
