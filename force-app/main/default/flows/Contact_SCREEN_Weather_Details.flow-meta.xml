{!Get_Contact_Details.MailingCountry}),
{!Get_Contact_Details.MailingState}),
{!Get_Contact_Details.MailingCity})</expression>
    </formulas>
    <formulas>
        <name>Formatted_12Hr_Time</name>
        <dataType>String</dataType>
        <expression>TEXT(
    IF(
        MOD(VALUE(MID({!Weather_API_Callout.2XX.location.localtime}, 12, 2)), 12) == 0,
        12,
        MOD(VALUE(MID({!Weather_API_Callout.2XX.location.localtime}, 12, 2)), 12)
    )
) 
&amp; &quot;:&quot; &amp; 
MID({!Weather_API_Callout.2XX.location.localtime}, 15, 2) 
&amp; &quot; &quot; &amp; 
IF(VALUE(MID({!Weather_API_Callout.2XX.location.localtime}, 12, 2)) &gt;= 12, &quot;PM&quot;, &quot;AM&quot;)</expression>
    </formulas>
